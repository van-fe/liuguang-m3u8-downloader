{
  "name": "liuguang-m3u8-downloader",
  "version": "1.2.11",
  "license": "GPL-2.0-or-later",
  "private": true,
  "type": "module",
  "description": "Chrome extension that detects HLS and X videos and saves local MP4 files",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:store": "node scripts/build-store.mjs",
    "test": "node --test tests/*.test.js",
    "test:e2e": "node scripts/e2e.mjs",
    "test:concurrency": "node scripts/concurrency-e2e.mjs",
    "test:filename": "node scripts/filename-e2e.mjs",
    "test:rename": "node scripts/local-rename-e2e.mjs",
    "test:permission": "node scripts/local-permission-e2e.mjs",
    "test:large": "node scripts/large-e2e.mjs",
    "test:x": "node scripts/x-e2e.mjs"
  },
  "dependencies": {
    "@ffmpeg/core": "0.12.10",
    "@ffmpeg/ffmpeg": "0.12.15",
    "hls.js": "1.6.13"
  },
  "devDependencies": {
    "playwright": "1.56.1"
  }
}
